# Copy to .env and fill in ONE of the provider blocks below.
# Grove talks plain OpenAI-compatible chat-completions, so any such endpoint works.

# --- Featherless.ai (default) ------------------------------------------------
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=
LLM_BIG_MODEL=moonshotai/Kimi-K2-Instruct
LLM_SMALL_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# --- Local Ollama: no account, no key, no cost -------------------------------
# ollama pull llama3.1:8b && ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local
# LLM_BIG_MODEL=llama3.1:8b
# LLM_SMALL_MODEL=qwen2.5:7b

# --- Groq (free tier, very fast) ---------------------------------------------
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_BIG_MODEL=llama-3.3-70b-versatile
# LLM_SMALL_MODEL=llama-3.1-8b-instant

# --- OpenRouter --------------------------------------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_BIG_MODEL=deepseek/deepseek-chat
# LLM_SMALL_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional: a vision model, used for image OCR if tesseract.js isn't installed
LLM_VISION_MODEL=

# Local models can be slow; raise this if you see timeouts.
LLM_TIMEOUT_MS=300000

# Retrieval: 'local' = built-in TF-IDF/BM25 vector store (no extra API calls)
#            'api'   = OpenAI-compatible /embeddings on LLM_BASE_URL
GROVE_EMBED_PROVIDER=local
GROVE_EMBED_MODEL=BAAI/bge-large-en-v1.5

PORT=3000

# Tuning
GROVE_CHUNK_CHARS=900
GROVE_CHUNK_OVERLAP=150
GROVE_RETRIEVE_K=8
GROVE_VERIFY_ROUNDS=3
GROVE_GAP_FLOOR=0.34
